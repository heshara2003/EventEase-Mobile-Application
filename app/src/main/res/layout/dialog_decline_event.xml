<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Decline Event?"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Are you sure you want to decline this event? This will mark the status as Declined."
        android:textSize="16sp"
        android:textColor="#757575"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmDecline"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Decline"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="#E81C1C"
        android:textColor="@color/white"
        app:cornerRadius="12dp"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelDecline"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="@color/white"
        android:textColor="#757575"
        app:strokeColor="#EEEEEE"
        app:strokeWidth="1dp"
        app:cornerRadius="12dp" />

</LinearLayout>